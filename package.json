{
  "name": "template-autocomplete",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "jest",
    "test:unit:watch": "jest --watch",
    "test:unit:coverage": "jest --coverage",
    "test:integration": "playwright test",
    "test:integration:ui": "playwright test --ui",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit:file": "jest --testPathPattern",
    "test:unit:pattern": "jest --testNamePattern",
    "test:unit:components": "jest tests/jest/components",
    "test:unit:hooks": "jest tests/jest/hooks",
    "test:unit:utils": "jest tests/jest/utils",
    "test:unit:adversarial": "jest tests/jest/utils/autocompleteUtils.adversarial.test.ts",
    "test:unit:watch:file": "jest --watch --testPathPattern",
    "test:e2e:file": "playwright test --grep",
    "test:e2e:pattern": "playwright test --grep",
    "test:e2e:browser": "playwright test --project",
    "test:e2e:headed": "HEADED=1 playwright test",
    "test:e2e:headed:chromium": "HEADED=1 playwright test --project chromium",
    "test:e2e:headed:firefox": "HEADED=1 playwright test --project firefox",
    "test:e2e:backspace": "playwright test tests/playwright/specs/backspace-behavior.spec.ts",
    "test:e2e:backspace:headed": "HEADED=1 playwright test tests/playwright/specs/backspace-behavior.spec.ts",
    "test:e2e:debug": "playwright test --debug",
    "test:list": "node scripts/test-list.js",
    "test:backspace": "npm run test:e2e:backspace",
    "test:backspace:gui": "npm run test:e2e:backspace:headed",
    "test:copypaste": "playwright test tests/playwright/specs/copy-paste-behavior.spec.ts",
    "test:copypaste:gui": "HEADED=1 playwright test tests/playwright/specs/copy-paste-behavior.spec.ts",
    "test:single-backspace": "playwright test tests/playwright/specs/backspace-behavior.spec.ts --grep 'removes entire autocomplete node with single backspace'",
    "test:single-backspace:gui": "HEADED=1 playwright test tests/playwright/specs/backspace-behavior.spec.ts --grep 'removes entire autocomplete node with single backspace'",
    "test:multi-backspace": "playwright test tests/playwright/specs/backspace-behavior.spec.ts --grep 'handles multiple consecutive autocomplete nodes'",
    "test:multi-backspace:gui": "HEADED=1 playwright test tests/playwright/specs/backspace-behavior.spec.ts --grep 'handles multiple consecutive autocomplete nodes'",
    "test:headed": "npm run test:e2e:headed",
    "test:feature:autocomplete": "jest tests/jest/utils/autocompleteUtils && playwright test tests/playwright/specs",
    "test:feature:backspace": "playwright test tests/playwright/specs/backspace-behavior.spec.ts",
    "test:quick": "jest tests/jest/utils/autocompleteUtils.core.test.ts",
    "test:debug": "jest --verbose --no-cache",
    "test:performance": "jest tests/jest/utils/autocompleteUtils.adversarial.test.ts --testNamePattern='Performance|performance'",
    "test:stress": "jest tests/jest/utils/autocompleteUtils.adversarial.test.ts --testNamePattern='stress|Stress|massive'"
  },
  "dependencies": {
    "@lexical/react": "^0.24.0",
    "lexical": "^0.24.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.28.3",
    "@babel/preset-react": "^7.27.1",
    "@babel/preset-typescript": "^7.27.1",
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "babel-jest": "^30.0.5",
    "globals": "^15.14.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.0.5",
    "jest-environment-jsdom": "^30.0.5",
    "typescript": "~5.7.2",
    "vite": "^6.1.0",
    "wrangler": "^4.33.1"
  }
}
